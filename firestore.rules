rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Auth helpers
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns null when the role claim is absent — no privileged fallback.
    function getRole() {
      return isAuthenticated() ? request.auth.token.get('role', null) : null;
    }

    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    function isSuperAdmin() { return hasRole('superAdmin'); }
    function isAdmin()      { return hasRole('admin'); }
    function isClinical()   { return hasRole('clinico'); }
    function isTech()       { return hasRole('tecnico'); }
    function isFinancial()  { return hasRole('financeiro'); }
    function isHR()         { return hasRole('rh'); }

    // Convenience composites
    function isPrivileged()       { return isSuperAdmin() || isAdmin(); }
    function canAccessClinical()  { return isPrivileged() || isClinical(); }
    function canAccessFinancial() { return isPrivileged() || isFinancial(); }
    function canAccessOps()       { return isPrivileged() || isTech(); }
    function canAccessHR()        { return isPrivileged() || isHR(); }

    // -------------------------------------------------------------------------
    // Users
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isPrivileged() || request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Clinical — residentes, prontuário, sinais vitais, medicações, eMAR
    // -------------------------------------------------------------------------

    match /residents/{residentId} {
      allow read: if canAccessClinical() || isFinancial();
      allow write: if canAccessClinical();
    }

    match /residents/{residentId}/{subcollection=**} {
      allow read, write: if canAccessClinical();
    }

    match /vitalSigns/{docId} {
      allow read, write: if canAccessClinical();
    }

    match /evolutionRecords/{docId} {
      allow read, write: if canAccessClinical();
    }

    match /medications/{docId} {
      allow read, write: if canAccessClinical();
    }

    match /administrations/{docId} {
      allow read, write: if canAccessClinical();
    }

    // Prescrições e eMAR — planejado para Fase 2 (issues #11, #12)
    match /prescricoes/{docId} {
      allow read, write: if canAccessClinical();
    }

    match /emar/{pacienteId}/doses/{doseId} {
      allow read, write: if canAccessClinical();
    }

    // Alertas clínicos gerados por Cloud Functions — somente leitura para clínicos
    match /alertasClinicas/{residenteId} {
      allow read: if canAccessClinical();
      allow write: if false; // Admin SDK (Cloud Functions) bypasses rules
    }

    // -------------------------------------------------------------------------
    // Financeiro
    // -------------------------------------------------------------------------

    match /billingItems/{docId} {
      allow read, write: if canAccessFinancial();
    }

    match /accounts/{docId} {
      allow read, write: if canAccessFinancial();
    }

    match /transactions/{docId} {
      allow read, write: if canAccessFinancial();
    }

    match /expenses/{docId} {
      allow read, write: if canAccessFinancial();
    }

    // Faturas de residentes — planejado para Fase 3 (issue #14)
    match /faturas/{docId} {
      allow read, write: if canAccessFinancial();
    }

    // Categorias são lidas por todos os módulos autenticados
    match /categories/{docId} {
      allow read: if isAuthenticated();
      allow write: if canAccessFinancial();
    }

    // Histórico de preços — compartilhado entre financeiro e operacional
    match /priceHistories/{docId} {
      allow read, write: if canAccessFinancial() || canAccessOps();
    }

    // -------------------------------------------------------------------------
    // Operacional — inventário, manutenção, ativos, compras
    // -------------------------------------------------------------------------

    match /inventoryItems/{docId} {
      // Clínicos precisam ler inventário (ex: verificar disponibilidade de insumos)
      allow read: if canAccessOps() || isClinical();
      allow write: if canAccessOps();
    }

    match /inventoryItems/{docId}/{subcollection=**} {
      allow read: if canAccessOps() || isClinical();
      allow write: if canAccessOps();
    }

    match /maintenanceLogs/{docId} {
      allow read, write: if canAccessOps();
    }

    match /workOrders/{docId} {
      allow read, write: if canAccessOps();
    }

    match /assets/{docId} {
      // Clínicos podem precisar ver equipamentos médicos disponíveis
      allow read: if canAccessOps() || isClinical();
      allow write: if canAccessOps();
    }

    match /shoppingLists/{docId} {
      allow read, write: if canAccessOps() || canAccessFinancial();
    }

    // -------------------------------------------------------------------------
    // RH / Colaboradores
    // -------------------------------------------------------------------------

    match /employees/{docId} {
      allow read: if canAccessHR();
      // Escrita restrita a privilegiados; atribuição de roles vai via Cloud Function
      allow write: if isPrivileged();
    }

    match /salaryAdvances/{docId} {
      allow read: if canAccessHR() || canAccessFinancial();
      allow write: if isPrivileged() || isHR();
    }

    // -------------------------------------------------------------------------
    // Convites — gerenciados exclusivamente por Cloud Functions (Admin SDK)
    // -------------------------------------------------------------------------

    match /invites/{token} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Logs de auditoria — append-only via Cloud Functions
    // -------------------------------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Notificações
    // -------------------------------------------------------------------------

    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow write: if canAccessClinical() || isTech() || isFinancial();
    }

    // -------------------------------------------------------------------------
    // Email — gerenciado pela extensão Trigger Email (Admin SDK via Functions)
    // -------------------------------------------------------------------------

    match /mail/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Rate limiting — gerenciado exclusivamente por Cloud Functions (Admin SDK)
    // -------------------------------------------------------------------------

    match /_rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
